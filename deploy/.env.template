# Grafana Cloud credentials for monitoring.
# Copy this file to .env and fill in your values.
# See https://grafana.com/docs/grafana-cloud/monitor-infrastructure/integrations/
GRAFANA_PROMETHEUS_URL=
GRAFANA_PROMETHEUS_USER=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_API_KEY=

# App server configuration
REDIS_URL=redis://10.0.1.10:6379
BROWSER_POOL=8
READER_WORKERS=8
MAX_CONCURRENT=32
RENDER_TIMEOUT=20
RATE_WINDOW=60
RATE_PER_USER=10
RATE_PER_IP=30
